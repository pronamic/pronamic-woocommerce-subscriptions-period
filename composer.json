{
	"name": "pronamic/wp-pronamic-woocommerce-subscriptions-period",
	"description": "This “WooCommerce Subscriptions” add-on ensures that a period is saved with each subscription order.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"pronamic",
		"pronamic-pay",
		"wordpress",
		"wordpress-plugin"
	],
	"autoload": {
		"psr-4": {
			"Pronamic\\WooCommerceSubscriptionsPeriod\\": "psr-4/"
		}
	},
	"authors": [
		{
			"name": "Pronamic",
			"email": "info@pronamic.eu",
			"homepage": "https://www.pronamic.eu/",
			"role": "Developer"
		},
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "https://www.remcotolsma.nl/",
			"role": "Developer"
		}
	],
	"repositories": [
		{
			"name": "wp-packages",
			"type": "composer",
			"url": "https://repo.wp-packages.org"
		},
		{
			"type": "package",
			"package": {
				"name": "pronamic/woocommerce-subscriptions",
				"version": "9.3.0",
				"type": "wordpress-plugin",
				"dist": {
					"url": "https://github.com/pronamic/woocommerce-subscriptions/releases/download/v9.3.0/woocommerce-subscriptions.9.3.0.zip",
					"type": "zip"
				},
				"source": {
					"url": "https://github.com/pronamic/woocommerce-subscriptions",
					"type": "github",
					"reference": "tags/v9.3.0"
				}
			}
		}
	],
	"config": {
		"allow-plugins": {
			"automattic/jetpack-autoloader": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"platform-check": false,
		"sort-packages": true
	},
	"require": {
		"php": "^8.3",
		"automattic/jetpack-autoloader": "^6.0",
		"composer/installers": "^2.3",
		"pronamic/pronamic-wp-updater": "^1.0"
	},
	"require-dev": {
		"php-stubs/woocommerce-stubs": "^11.2",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"pronamic/woocommerce-subscriptions": "^9.3",
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.6",
		"roots/wordpress-no-content": "^7.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"wp-plugin/woocommerce": "^11.2"
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:solvebeam",
				"vendor:wp-pay",
				"vendor:wp-plugin",
				"woocommerce/action-scheduler"
			]
		},
		"wp-slug": "pronamic-woocommerce-subscriptions-period"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-woocommerce-subscriptions-period/",
			"vendor/bin/wp i18n make-pot ./build/pronamic-woocommerce-subscriptions-period/ --slug=pronamic-woocommerce-subscriptions-period",
			"vendor/bin/wp i18n make-mo ./build/pronamic-woocommerce-subscriptions-period/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-woocommerce-subscriptions-period/ --plugin-dirname=pronamic-woocommerce-subscriptions-period --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=pronamic-woocommerce-subscriptions-period",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-woocommerce-subscriptions-period/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-woocommerce-subscriptions-period.pot"
		],
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=-1",
		"rector": "vendor/bin/rector process --dry-run"
	}
}
